      border: none;
      border-radius: 15px;
    }

    .form-control {
      border-radius: 10px;
      padding: 12px;
    }

    .form-control:focus {
      box-shadow: 0 0 0 0.15rem rgba(76, 175, 80, 0.25);
      border-color: #4CAF50;
    }

    .btn-success {
      border-radius: 10px;
      padding: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .logo-circle {
      width: 60px;
      height: 60px;
      background: #4CAF50;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px;
      color: white;
      font-size: 26px;
    }
  </style>

